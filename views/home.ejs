<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<!-- start navbar -->
<nav>
    <ul>
        <li><a href="#head">head</a></li>
        <li><a href="#aboutme">aboutme</a></li>
        <li><a href="#progress">progress</a></li>
        <li><a href="#tryit">tryit</a></li>
        <li><a href="#contactme">contactme</a></li>
    </ul>
</nav>
<!-- end navbar -->
<!-- start head [cover] -->
 <header>
    <div class="coverpage">
        <h2>Hi ! Iam <%=info.fullName %></h2>
        <span class="badge"><%= info.job %></span>
        <p><%= info.bio %></p>
    </div>
 </header>
<!-- end head [cover] -->
<!-- start aboutme  -->
 <section id="aboutme">
    <ul>
        <li><%= info.firstName %> <%= info.lastName %></li>
        <li><%= info.job %></li>
        <li><%= info.age  %> year</li>
        <li>from <%= info.country %></li>
        <li>current lived in <%= info.currentCountry %></li>
        <li>username in github : <%= info.usernameOnGithub %></li>
    </ul>
 </section>
<!-- end aboutme  -->
<!-- start progress -->

<div>
        <h3>frontend</h3>
     <ul>
        <%  for (let i in info.progress.frontend) { %>
                <li><%=info.progress.frontend[i].name %></li>
                <li><%=info.progress.frontend[i].progress %>%</li>
        <% } %>
    </ul>
</div>

<div>
        <h3>backend</h3>
        <ul>
        <%  for (let i in info.progress.backend) { %>
                <li><%=info.progress.backend[i].name %></li>
                <li><%=info.progress.backend[i].progress %>%</li>
        <% } %>
        </ul>
</div>


<div>
        <h3>typing </h3>
        <ul>
        <%  for (let i in info.progress.typing) { %>
                <li><%=info.progress.typing[i].name %></li>
                <li><%=info.progress.typing[i].progress %>%</li>
        <% } %>
        </ul>
</div>


<div>
        <h3>tools </h3>
        <ul>
        <%  for (let i in info.progress.tools) { %>
                <li><%=info.progress.tools[i].name %></li>
                <li><%=info.progress.tools[i].progress %>%</li>
        <% } %>
        </ul>
</div>


<div>
        <h3>operation systems </h3>
        <ul>
        <%  for (let i in info.progress.os) { %>
                <li><%=info.progress.os[i].name %></li>
                <li><%=info.progress.os[i].progress %>%</li>
        <% } %>
        </ul>
</div>

<!-- end progress -->

<!-- start try  -->
    <section id="tryit">
          <h3>everythings try it </h3>
        <p>in my live I try more than things in computer world ! </p>
      
        <h3>in progrmming </h3>
                <p>
        <%  info.try.programming.forEach(i =>  { %>
                <li><%=i%></li>
        <% } )%>
        </p>


                <h4>in operation systems [ linux ] </h4>
                <p>
        <%  info.try.os.linux.forEach(i =>  { %>
                <li><%=i%></li>
        <% } )%>
        </p>


                <h4>in operation systems [ mac ] </h4>
                <p>
        <%  info.try.os.mac.forEach(i =>  { %>
                <li><%=i%></li>
        <% } )%>
        </p>


           <h4>in operation systems [ windows ] </h4>
                <p>
        <%  info.try.os.windows.forEach(i =>  { %>
                <li><%=i%></li>
        <% } )%>
        </p>

    </section>
<!-- end try  -->
<!-- start contactme -->
<section id="contactme">
<p>you can contact me for any advice or job </p>
<ul>
    <li>account in github :  <a href="#">github</a></li>
    <li>E-mail :  <a href="emailto: <%=info.email %>">gmail</a></li>
</ul>
</section>
<!-- end contactme -->
</body>
</html>